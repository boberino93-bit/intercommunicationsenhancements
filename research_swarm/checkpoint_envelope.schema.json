{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boberino93-bit/intercommunicationsenhancements/research_swarm/checkpoint_envelope.schema.json",
  "title": "Scheduled Swarm Stage Checkpoint Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checkpoint_id",
    "cycle_id",
    "stage",
    "run_id",
    "sequence",
    "state",
    "phase",
    "trigger",
    "created_at",
    "source_revisions",
    "upstream_checkpoint_ids",
    "evidence_refs",
    "summary",
    "blockers",
    "unfinished_work",
    "next_action"
  ],
  "properties": {
    "schema": {
      "const": "intercommunications/swarm-stage-checkpoint/v1"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00[+-][0-9]{2}:[0-9]{2}$"
    },
    "recovery_of_cycle_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00[+-][0-9]{2}:[0-9]{2}$"
    },
    "stage": {
      "enum": ["RESEARCHER_1", "MANAGER", "PRIMARY"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "RESEARCH_PROGRESS",
        "RESEARCH_HANDOFF_READY",
        "MANAGER_PROGRESS",
        "MANAGER_HANDOFF_READY",
        "PRIMARY_PROGRESS",
        "PRIMARY_PROPOSAL_READY",
        "CHECKPOINT_IO_BLOCKED",
        "UPSTREAM_NOT_READY",
        "INTENTIONAL_STOP",
        "INTEGRITY_QUARANTINE"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trigger": {
      "enum": ["SCHEDULED", "USER_INTERACTIVE", "RECOVERY", "RETRY"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "upstream_checkpoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "maxLength": 12000
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unfinished_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_action": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"stage": {"const": "RESEARCHER_1"}}
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "RESEARCH_PROGRESS",
              "RESEARCH_HANDOFF_READY",
              "CHECKPOINT_IO_BLOCKED",
              "UPSTREAM_NOT_READY",
              "INTENTIONAL_STOP",
              "INTEGRITY_QUARANTINE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage": {"const": "MANAGER"}}
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "MANAGER_PROGRESS",
              "MANAGER_HANDOFF_READY",
              "CHECKPOINT_IO_BLOCKED",
              "UPSTREAM_NOT_READY",
              "INTENTIONAL_STOP",
              "INTEGRITY_QUARANTINE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage": {"const": "PRIMARY"}}
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "PRIMARY_PROGRESS",
              "PRIMARY_PROPOSAL_READY",
              "CHECKPOINT_IO_BLOCKED",
              "UPSTREAM_NOT_READY",
              "INTENTIONAL_STOP",
              "INTEGRITY_QUARANTINE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"trigger": {"const": "USER_INTERACTIVE"}}
      },
      "then": {
        "required": ["recovery_of_cycle_id"]
      }
    }
  ]
}
