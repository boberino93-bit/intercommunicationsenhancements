{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-agent-mesh/scheduled-spawn-ticket/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ticket_id",
    "job_id",
    "occurrence_id",
    "scheduled_for",
    "observed_at",
    "launch_scope",
    "requested_roles",
    "max_workers",
    "status",
    "authority_conveyed",
    "mutation_authority_conveyed"
  ],
  "properties": {
    "schema": {"const": "org-agent-mesh/scheduled-spawn-ticket/v1"},
    "ticket_id": {"type": "string", "minLength": 8},
    "job_id": {"type": "string", "minLength": 1},
    "occurrence_id": {"type": "string", "minLength": 1},
    "scheduled_for": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "launch_scope": {"type": "string", "minLength": 1},
    "requested_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["research", "manager"]}
    },
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 1},
    "status": {
      "enum": [
        "SPAWN_TICKET_PENDING",
        "DISPATCH_REQUESTED",
        "DISPATCH_ACCEPTED_START_UNVERIFIED",
        "SESSION_STARTED_VERIFIED",
        "SPAWN_ADAPTER_UNAVAILABLE",
        "SPAWN_ADAPTER_REJECTED"
      ]
    },
    "adapter_result": {"type": ["string", "null"]},
    "host_start_receipt": {"type": ["string", "null"]},
    "authority_conveyed": {"const": false},
    "mutation_authority_conveyed": {"const": false}
  }
}
