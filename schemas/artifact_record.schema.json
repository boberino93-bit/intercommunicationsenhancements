{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project-scoped Artifact Record",
  "type": "object",
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "creator_agent_id": {"type": "string", "minLength": 1},
    "creator_agent_instance_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "artifact_type": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "integer", "minimum": 1},
    "created_at_utc": {"type": "string"},
    "updated_at_utc": {"type": "string"}
  },
  "required": ["project_id", "artifact_id", "creator_agent_id", "creator_agent_instance_id", "task_id", "artifact_type", "source", "content_sha256", "version", "created_at_utc", "updated_at_utc"]
}
