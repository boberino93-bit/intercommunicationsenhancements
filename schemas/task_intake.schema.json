{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization Agent Mesh Task Intake",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "org-agent-mesh/task-intake/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "intake_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["EXISTING_PROJECT_TASK", "NEW_PROJECT_BOOTSTRAP", "CROSS_PROJECT_EXCHANGE", "FRAMEWORK_MAINTENANCE", "AMBIGUOUS_PROJECT"]},
    "objective": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "non_goals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_of_truth_hierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "trust_class": {"enum": ["AUTHORITATIVE_CONFIG", "VERIFIED_FACT", "EXECUTION_EVIDENCE", "DERIVED_KNOWLEDGE", "EXTERNAL_UNTRUSTED", "QUARANTINED"]}
        },
        "required": ["rank", "label", "reference", "trust_class"]
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workstream_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "write_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "completion_condition": {"type": "string", "minLength": 1}
        },
        "required": ["workstream_id", "objective", "dependencies", "source_refs", "write_scope", "completion_condition"]
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consequence_of_error": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "risky_modification_blocked": {"type": "boolean"},
        "block_reason": {"type": ["string", "null"]},
        "unblock_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["consequence_of_error", "risky_modification_blocked", "block_reason", "unblock_evidence"]
    },
    "research_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistance_required": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "attempt_count": {"type": "integer", "minimum": 0},
        "stall_count": {"type": "integer", "minimum": 0},
        "parallel_fronts": {"type": "integer", "minimum": 1},
        "dependency_density": {"type": "number", "minimum": 0, "maximum": 1},
        "domains": {"type": "integer", "minimum": 1},
        "conflicting_evidence": {"type": "boolean"},
        "independent_verification_required": {"type": "boolean"},
        "tool_or_capability_gap": {"type": "boolean"},
        "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "proposed_research_agents": {"type": "integer", "minimum": 0},
        "proposed_manager_agents": {"type": "integer", "minimum": 0},
        "topology": {"enum": ["NONE", "PRIMARY_DIRECT", "SINGLE_MANAGER_CELL", "MULTI_MANAGER_CELLS"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": ["assistance_required", "confidence", "attempt_count", "stall_count", "parallel_fronts", "dependency_density", "domains", "conflicting_evidence", "independent_verification_required", "tool_or_capability_gap", "novelty", "proposed_research_agents", "proposed_manager_agents", "topology", "rationale"]
    },
    "delegation_contract_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_by_agent_id": {"type": "string", "minLength": 1},
    "created_by_agent_instance_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1}
  },
  "required": ["schema", "project_id", "intake_id", "mode", "objective", "problem_statement", "constraints", "non_goals", "source_of_truth_hierarchy", "workstreams", "risk", "research_assessment", "delegation_contract_ids", "created_by_agent_id", "created_by_agent_instance_id", "created_at_utc"],
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "AMBIGUOUS_PROJECT"}}},
      "then": {"properties": {"delegation_contract_ids": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"research_assessment": {"properties": {"assistance_required": {"const": false}}}}},
      "then": {"properties": {"research_assessment": {"properties": {"proposed_research_agents": {"const": 0}, "proposed_manager_agents": {"const": 0}, "topology": {"const": "NONE"}}}}}
    }
  ]
}
