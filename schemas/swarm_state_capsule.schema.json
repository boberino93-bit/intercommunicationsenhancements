{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Swarm State Capsule",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "swarm_id": {"type": "string", "minLength": 1},
    "coordinator_epoch": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "project_capsules": {"type": "array", "minItems": 1, "items": {"$ref": "project_state_capsule.schema.json"}},
    "quarantined_projects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "global_freeze": {"type": "boolean"},
    "updated_at_utc": {"type": "string", "minLength": 1}
  },
  "required": ["swarm_id", "coordinator_epoch", "protocol_version", "project_capsules", "quarantined_projects", "global_freeze", "updated_at_utc"]
}
