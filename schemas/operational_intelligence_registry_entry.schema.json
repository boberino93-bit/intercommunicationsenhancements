{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operational Intelligence Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "org-agent-mesh/operational-intelligence-registry-entry/v1"},
    "entry_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "peer_project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "consumer_project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "themes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expertise_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "capability_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "availability_state": {"enum": ["AVAILABLE", "ACTIVE", "BUSY", "BLOCKED", "WAITING", "COMPLETED", "OFFLINE", "UNKNOWN"]},
    "validated_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_conveyed": {"const": false}
  },
  "required": ["schema", "entry_id", "peer_project_id", "consumer_project_id", "themes", "expertise_tags", "capability_refs", "availability_state", "validated_at_utc", "expires_at_utc", "provenance_refs", "authority_conveyed"]
}
