{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project-scoped Append-only Message v2",
  "type": "object",
  "properties": {
    "schema": {"const": "org-agent-mesh/message/v2"},
    "protocol_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "destination_project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "timestamp_utc": {"type": "string"},
    "from_agent": {"type": "string", "minLength": 1},
    "from_agent_instance_id": {"type": "string", "minLength": 1},
    "from_role": {"type": "string", "minLength": 1},
    "to": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "kind": {"enum": ["CLAIM", "FINDING", "BLOCKER", "REQUEST", "REVIEW_REQUEST", "REVIEW_DISPOSITION", "CONTRADICTION", "HANDOFF", "DECISION", "SUPERSESSION", "SERVICE_CHECKPOINT", "RELEASE_CLOSE"]},
    "priority": {"enum": ["normal", "high", "critical"]},
    "subject": {"type": "string"},
    "summary": {"type": "string"},
    "applies_to_state": {},
    "evidence": {"type": "array"},
    "artifacts": {"type": "array"},
    "reply_to": {"type": ["string", "null"]},
    "supersedes": {"type": "array"},
    "requires_ack": {"type": "boolean"},
    "tags": {"type": "array"},
    "correlation_id": {"type": ["string", "null"]},
    "causation_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": ["string", "null"]},
    "expires_at_utc": {"type": ["string", "null"]}
  },
  "required": ["schema", "protocol_version", "id", "project_id", "destination_project_id", "timestamp_utc", "from_agent", "from_agent_instance_id", "from_role", "to", "kind", "priority", "subject", "summary", "applies_to_state", "evidence", "artifacts", "reply_to", "supersedes", "requires_ack", "tags", "correlation_id", "causation_id", "idempotency_key", "expires_at_utc"]
}
