{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Rendezvous Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rendezvous_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "required_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "optional_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "consumer": {"type": "string", "minLength": 1},
    "timeout_at_utc": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "COMPLETED", "TIMED_OUT", "ESCALATED"]},
    "arrivals": {"type": "object"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "completed_at_utc": {"type": ["string", "null"]},
    "updated_by_agent_instance_id": {"type": "string", "minLength": 1},
    "missing_required_nodes": {"type": "array", "items": {"type": "string"}},
    "timed_out_at_utc": {"type": "string"}
  },
  "required": ["rendezvous_id", "generation_id", "required_nodes", "optional_nodes", "consumer", "timeout_at_utc", "status", "arrivals", "created_at_utc", "completed_at_utc", "updated_by_agent_instance_id"]
}
