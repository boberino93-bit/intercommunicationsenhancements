{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-agent-mesh/swarm-prompt-registry/v1",
  "title": "Swarm Prompt Registry",
  "type": "object",
  "required": ["schema", "registry_version", "updated_at", "entries"],
  "properties": {
    "schema": {"const": "org-agent-mesh/swarm-prompt-registry/v1"},
    "registry_version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "PENDING", "CLAIMED", "IN_PROGRESS", "BLOCKED_AUTHORIZATION",
        "BLOCKED_DEPENDENCY", "BLOCKED_PROJECT_HOLD", "COMPLETED", "HISTORIC",
        "CANCELLED", "SUPERSEDED", "EXPIRED", "REJECTED", "QUARANTINED"
      ]
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "changed_at", "changed_by", "provenance_ref"],
      "properties": {
        "from": {"type": ["string", "null"]},
        "to": {"$ref": "#/$defs/status"},
        "changed_at": {"type": "string", "format": "date-time"},
        "changed_by": {"type": "string"},
        "provenance_ref": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "prompt_id", "title", "short_description", "schema_version", "registered_at",
        "registered_by_claimed_identity", "originating_role", "originating_project",
        "target_role", "global_visibility", "execution_eligibility_rule", "current_status",
        "status_changed_at", "status_changed_by", "priority", "authority_conveyed",
        "audit_history"
      ],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "short_description": {"type": "string", "minLength": 1},
        "full_prompt_ref": {"type": ["string", "null"]},
        "content_digest": {"type": ["string", "null"]},
        "schema_version": {"type": "string"},
        "registry_version": {"type": ["integer", "null"]},
        "registered_at": {"type": "string", "format": "date-time"},
        "registered_by_claimed_identity": {"type": "string"},
        "registered_by_authenticated_identity": {"type": ["string", "null"]},
        "registration_authorization_case_ref": {"type": ["string", "null"]},
        "originating_agent": {"type": ["string", "null"]},
        "originating_role": {"type": "string"},
        "originating_project": {"type": "string"},
        "target_project": {"type": ["string", "null"]},
        "target_project_rule": {"type": ["string", "null"]},
        "target_role": {"type": "string"},
        "global_visibility": {"type": "string"},
        "execution_eligibility_rule": {"type": "string"},
        "current_status": {"$ref": "#/$defs/status"},
        "status_changed_at": {"type": "string", "format": "date-time"},
        "status_changed_by": {"type": "string"},
        "priority": {"type": "string"},
        "consequence_classification": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": ["string", "null"]},
        "superseded_by": {"type": ["string", "null"]},
        "claimed_by": {"type": ["string", "null"]},
        "claimed_at": {"type": ["string", "null"], "format": "date-time"},
        "execution_project": {"type": ["string", "null"]},
        "completion_ref": {"type": ["string", "null"]},
        "cancellation_ref": {"type": ["string", "null"]},
        "rejection_ref": {"type": ["string", "null"]},
        "expiry": {"type": ["string", "null"], "format": "date-time"},
        "related_forum_message_refs": {"type": "array", "items": {"type": "string"}},
        "related_artifact_refs": {"type": "array", "items": {"type": "string"}},
        "related_commits_prs_issues": {"type": "array", "items": {"type": "string"}},
        "authority_conveyed": {"const": false},
        "audit_history": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
