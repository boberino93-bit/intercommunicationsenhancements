{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project-scoped Task Record",
  "type": "object",
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "creator_agent_id": {"type": "string", "minLength": 1},
    "creator_agent_instance_id": {"type": "string", "minLength": 1},
    "owner_agent_id": {"type": ["string", "null"]},
    "owner_agent_instance_id": {"type": ["string", "null"]},
    "parent_task_id": {"type": ["string", "null"]},
    "status": {"enum": ["OPEN", "ACTIVE", "BLOCKED", "COMPLETED", "FAILED", "CANCELLED"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at_utc": {"type": "string"},
    "updated_at_utc": {"type": "string"}
  },
  "required": ["project_id", "task_id", "creator_agent_id", "creator_agent_instance_id", "owner_agent_id", "owner_agent_instance_id", "parent_task_id", "status", "version", "created_at_utc", "updated_at_utc"]
}
