{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanitized Intelligence Snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "org-agent-mesh/sanitized-intelligence-snapshot/v1"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "subject": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "authority_conveyed": {"const": false}
  },
  "required": ["schema", "snapshot_id", "subject", "summary", "artifact_refs", "provenance_refs", "created_at_utc", "expires_at_utc", "authority_conveyed"]
}
