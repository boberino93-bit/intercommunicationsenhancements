{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"intercommunications/swarm-stage-checkpoint/v3",
  "title":"Project-Scoped Swarm Stage Checkpoint Envelope with Epistemic Delta References",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","project_id","authority_conveyed","checkpoint_id","cycle_id","stage","run_id","sequence","state","phase","trigger","created_at","source_revisions","upstream_checkpoint_ids","evidence_refs","summary","blockers","unfinished_work","next_action","epistemic"],
  "properties":{
    "schema":{"const":"intercommunications/swarm-stage-checkpoint/v3"},
    "project_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "authority_conveyed":{"const":false},
    "checkpoint_id":{"type":"string","minLength":1,"maxLength":512},
    "cycle_id":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00[+-][0-9]{2}:[0-9]{2}$"},
    "recovery_of_cycle_id":{"type":["string","null"]},
    "stage":{"enum":["RESEARCHER_1","RESEARCHER_2","RESEARCHER_3","MANAGER","PRIMARY"]},
    "run_id":{"type":"string","minLength":1,"maxLength":256},
    "sequence":{"type":"integer","minimum":0},
    "state":{"enum":["RESEARCH_PROGRESS","RESEARCH_HANDOFF_READY","MANAGER_PROGRESS","MANAGER_HANDOFF_READY","PRIMARY_PROGRESS","PRIMARY_PROPOSAL_READY","CHECKPOINT_IO_BLOCKED","UPSTREAM_NOT_READY","PROJECT_HOLD_ACTIVE","INTENTIONAL_STOP","INTEGRITY_QUARANTINE"]},
    "phase":{"type":"string","minLength":1,"maxLength":128},
    "trigger":{"enum":["SCHEDULED","USER_INTERACTIVE","RECOVERY","RETRY"]},
    "created_at":{"type":"string","format":"date-time"},
    "source_revisions":{"type":"object","additionalProperties":{"type":"string","minLength":1}},
    "upstream_checkpoint_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "summary":{"type":"string","maxLength":12000},
    "blockers":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "unfinished_work":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "next_action":{"type":"string","maxLength":4000},
    "epistemic":{"type":"object","additionalProperties":false,"required":["reconciliation_generation","epistemic_delta_refs","claims_created_or_updated","hypotheses_created_or_updated","contradiction_refs","source_identity_refs","duplicate_source_collapse_refs","pending_verification_refs","minority_finding_refs","unresolved_high_impact_question_refs"],"properties":{
      "reconciliation_generation":{"type":"integer","minimum":0},
      "epistemic_delta_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "claims_created_or_updated":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "hypotheses_created_or_updated":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "contradiction_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "source_identity_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "duplicate_source_collapse_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "pending_verification_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "minority_finding_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "unresolved_high_impact_question_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
    }}
  }
}
