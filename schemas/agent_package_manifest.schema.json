{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agent_spawn_policy": {"type": "object"},
    "artifact_root": {"minLength": 1, "type": "string"},
    "authority_tier": {"enum": ["ORCHESTRATOR", "REVIEWER", "SPECIALIST"]},
    "bootstrap_order_path": {"minLength": 1, "type": "string"},
    "built_at_utc": {"format": "date-time", "type": "string"},
    "canonical_branch": {"minLength": 1, "type": "string"},
    "capabilities": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "component_sha256": {"additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "minProperties": 1, "type": "object"},
    "coordination_root": {"minLength": 1, "type": "string"},
    "dependency_map_path": {"minLength": 1, "type": "string"},
    "dependency_map_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "deployment_role": {"enum": ["PRIMARY", "MANAGER", "RESEARCH"]},
    "framework_version": {"type": "string"},
    "identity_lock_path": {"minLength": 1, "type": "string"},
    "included_components": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "package_version": {"type": "string"},
    "project_id": {"pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$", "type": "string"},
    "protocol_version": {"type": "string"},
    "repository_identity": {"minLength": 3, "type": "string"},
    "schema": {"const": "org-agent-mesh/agent-package-manifest/v3"},
    "source_revision": {"pattern": "^[0-9a-fA-F]{40}$", "type": "string"}
  },
  "required": ["schema", "project_id", "repository_identity", "canonical_branch", "coordination_root", "artifact_root", "identity_lock_path", "bootstrap_order_path", "dependency_map_path", "dependency_map_sha256", "agent_spawn_policy", "deployment_role", "authority_tier", "capabilities", "framework_version", "protocol_version", "package_version", "built_at_utc", "source_revision", "component_sha256", "included_components"],
  "title": "Agent Deployment Package Manifest v3",
  "type": "object"
}
