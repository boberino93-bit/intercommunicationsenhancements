{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project-scoped Audit Record",
  "type": "object",
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_instance_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "message_id": {"type": ["string", "null"]},
    "resource_id": {"type": ["string", "null"]},
    "operation": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "before_version": {"type": ["integer", "null"]},
    "after_version": {"type": ["integer", "null"]},
    "timestamp_utc": {"type": "string"},
    "details": {"type": "object"}
  },
  "required": ["project_id", "audit_id", "agent_id", "agent_instance_id", "task_id", "message_id", "resource_id", "operation", "result", "before_version", "after_version", "timestamp_utc", "details"]
}
