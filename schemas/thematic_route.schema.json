{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thematic Route",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "themes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "destination": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "enabled": {"type": "boolean"},
    "updated_by_agent_instance_id": {"type": "string", "minLength": 1}
  },
  "required": ["route_id", "project_id", "themes", "destination", "priority", "enabled", "updated_by_agent_instance_id"]
}
