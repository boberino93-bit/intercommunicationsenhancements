{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-agent-mesh/priority-frontier-snapshot/v1",
  "title": "Priority Frontier Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "source_revisions", "generated_at_utc", "expires_at_utc", "project_order", "priority_provenance", "project_id", "open_frontier", "authority"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "project_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "priority_provenance": {"enum": ["HUMAN_SET", "POLICY_SET", "DERIVED", "INCOMPLETE"]},
    "project_id": {"type": "string", "minLength": 1},
    "project_priority": {"type": ["integer", "null"], "minimum": 1},
    "open_frontier": {"type": "array", "items": {"type": "string"}},
    "active_task_ids": {"type": "array", "items": {"type": "string"}},
    "active_claim_ids": {"type": "array", "items": {"type": "string"}},
    "recent_liveness": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "checkpoints": {"type": "array", "items": {"type": "string"}},
    "latest_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "recommended_next_actions": {"type": "array", "items": {"type": "string"}},
    "authority": {"const": false}
  }
}
