{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cross-project Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "org-agent-mesh/cross-project-acceptance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "request_ref": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
    "requesting_project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "target_project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
    "status": {"enum": ["ACCEPTED", "DECLINED", "UPDATE_PENDING", "UPDATE_ACCEPTED", "UPDATE_REJECTED", "SUPERSEDED"]},
    "local_task_ref": {"type": ["string", "null"]},
    "update_ref": {"type": ["string", "null"]},
    "supersedes_ref": {"type": ["string", "null"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_conveyed": {"const": false}
  },
  "required": ["schema", "receipt_id", "request_ref", "correlation_id", "requesting_project_id", "target_project_id", "status", "local_task_ref", "update_ref", "supersedes_ref", "created_at_utc", "expires_at_utc", "provenance_refs", "authority_conveyed"]
}
