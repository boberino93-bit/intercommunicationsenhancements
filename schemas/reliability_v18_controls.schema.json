{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"org-agent-mesh/reliability-v18-controls/v1",
  "title":"Reliability v1.8 control records",
  "$defs":{
    "controlDecision":{"type":"object","required":["decision","reason_code","subsystem","explanation"],"properties":{"decision":{"type":"string","minLength":1},"reason_code":{"type":"string","minLength":1},"subsystem":{"type":"string","minLength":1},"explanation":{"type":"string","minLength":1},"next_action":{"type":["string","null"]},"resource_or_slo":{"type":["string","null"]},"policy_ref":{"type":["string","null"]}},"additionalProperties":false},
    "humanIdentityAssertion":{"type":"object","required":["assertion_id","human_subject","auth_method","issuer","issued_at_utc","expires_at_utc","nonce","signature"],"properties":{"assertion_id":{"type":"string"},"human_subject":{"type":"string"},"auth_method":{"enum":["FIDO2","WEBAUTHN","HARDWARE_KEY","MFA_ROOT_CONSOLE"]},"issuer":{"type":"string"},"issued_at_utc":{"type":"string","format":"date-time"},"expires_at_utc":{"type":"string","format":"date-time"},"nonce":{"type":"string"},"signature":{"type":"string"}},"additionalProperties":false},
    "breakGlassGrant":{"type":"object","required":["grant_id","human_subject","project_id","target","reason","expected_recovery_action","capability_ceiling","issued_at_utc","expires_at_utc","nonce","assertion_id","signature"],"properties":{"grant_id":{"type":"string"},"human_subject":{"type":"string"},"project_id":{"type":"string"},"target":{"type":"string"},"reason":{"type":"string"},"expected_recovery_action":{"type":"string"},"capability_ceiling":{"type":"array","items":{"type":"string"},"uniqueItems":true},"issued_at_utc":{"type":"string","format":"date-time"},"expires_at_utc":{"type":"string","format":"date-time"},"nonce":{"type":"string"},"assertion_id":{"type":"string"},"signature":{"type":"string"}},"additionalProperties":false},
    "schemaRecord":{"type":"object","required":["schema_id","version","status","owner","compatibility","minimum_reader","minimum_writer","rollback_compatible"],"properties":{"schema_id":{"type":"string"},"version":{"type":"integer","minimum":1},"status":{"type":"string"},"owner":{"type":"string"},"compatibility":{"enum":["BACKWARD_COMPATIBLE","FORWARD_COMPATIBLE","BIDIRECTIONAL","BREAKING"]},"minimum_reader":{"type":"integer","minimum":1},"minimum_writer":{"type":"integer","minimum":1},"maximum_reader":{"type":["integer","null"],"minimum":1},"required_migration":{"type":["string","null"]},"rollback_compatible":{"type":"boolean"},"dependencies":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "migrationRecord":{"type":"object","required":["migration_id","schema_id","from_version","to_version","state","epoch","checkpoint_digest","applied_batches","verified_batches"],"properties":{"migration_id":{"type":"string"},"schema_id":{"type":"string"},"from_version":{"type":"integer","minimum":0},"to_version":{"type":"integer","minimum":1},"state":{"enum":["PLANNED","CANARY","IN_PROGRESS","PAUSED","ROLLBACK_PENDING","ROLLED_BACK","VERIFIED","COMPLETE","FAILED"]},"epoch":{"type":"integer","minimum":0},"checkpoint_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"applied_batches":{"type":"array","items":{"type":"string"}},"verified_batches":{"type":"array","items":{"type":"string"}},"rollback_reason":{"type":["string","null"]}},"additionalProperties":false},
    "capabilityEvidence":{"type":"object","required":["evidence_id","subject","capability","evaluator","dataset_id","sample_count","score","confidence","contaminated","issued_at_utc","expires_at_utc","provenance_digest","signature"],"properties":{"evidence_id":{"type":"string"},"subject":{"type":"string"},"capability":{"type":"string"},"evaluator":{"type":"string"},"dataset_id":{"type":"string"},"sample_count":{"type":"integer","minimum":1},"score":{"type":"number","minimum":0,"maximum":1},"confidence":{"type":"number","minimum":0,"maximum":1},"contaminated":{"type":"boolean"},"issued_at_utc":{"type":"string","format":"date-time"},"expires_at_utc":{"type":"string","format":"date-time"},"provenance_digest":{"type":"string"},"signature":{"type":"string"}},"additionalProperties":false},
    "rolloutState":{"type":"object","required":["rollout_id","artifact_digest","source_revision","ring_index","status","version","last_good_ring_index"],"properties":{"rollout_id":{"type":"string"},"artifact_digest":{"type":"string"},"source_revision":{"type":"string"},"ring_index":{"type":"integer","minimum":0,"maximum":5},"status":{"type":"string"},"version":{"type":"integer","minimum":1},"last_good_ring_index":{"type":"integer","minimum":0,"maximum":5},"quarantine_reason":{"type":["string","null"]}},"additionalProperties":false},
    "recoveryObjective":{"type":"object","required":["system_class","rpo_seconds","rto_seconds","max_backup_lag_seconds","max_checkpoint_age_seconds","max_unverified_effect_age_seconds","max_stale_claim_age_seconds","max_heartbeat_age_seconds","max_dormant_wake_latency_seconds"],"properties":{"system_class":{"type":"string"},"rpo_seconds":{"type":"integer","minimum":0},"rto_seconds":{"type":"integer","minimum":0},"max_backup_lag_seconds":{"type":"integer","minimum":0},"max_checkpoint_age_seconds":{"type":"integer","minimum":0},"max_unverified_effect_age_seconds":{"type":"integer","minimum":0},"max_stale_claim_age_seconds":{"type":"integer","minimum":0},"max_heartbeat_age_seconds":{"type":"integer","minimum":0},"max_dormant_wake_latency_seconds":{"type":"integer","minimum":0}},"additionalProperties":false},
    "slo":{"type":"object","required":["slo_id","metric","target","comparison","window_seconds","severity","error_budget","degraded_threshold","recovery_action"],"properties":{"slo_id":{"type":"string"},"metric":{"type":"string"},"target":{"type":"number"},"comparison":{"enum":[">=","<="]},"window_seconds":{"type":"integer","minimum":1},"severity":{"type":"string"},"error_budget":{"type":"number","minimum":0},"degraded_threshold":{"type":"number"},"recovery_action":{"type":"string"}},"additionalProperties":false},
    "supplyChainAttestation":{"type":"object","required":["artifact_id","source_repository","source_revision","builder_id","toolchain_id","dependency_inventory_digest","build_environment_digest","artifact_digest","vulnerability_status","trust_decision","promotion_ring","signature"],"properties":{"artifact_id":{"type":"string"},"source_repository":{"type":"string"},"source_revision":{"type":"string"},"builder_id":{"type":"string"},"toolchain_id":{"type":"string"},"dependency_inventory_digest":{"type":"string"},"build_environment_digest":{"type":"string"},"artifact_digest":{"type":"string"},"vulnerability_status":{"enum":["CLEAR","ACCEPTED_RISK","BLOCKED","UNKNOWN"]},"trust_decision":{"enum":["TRUSTED","UNTRUSTED","QUARANTINED"]},"promotion_ring":{"enum":["RING_0_LOCAL","RING_1_ISOLATED","RING_2_PROJECT_CANARY","RING_3_SMALL_COHORT","RING_4_BROADER_SWARM","RING_5_DEFAULT"]},"signature":{"type":"string"}},"additionalProperties":false},
    "credentialLease":{"type":"object","required":["credential_id","project_id","environment","capabilities","issued_at_utc","expires_at_utc","provenance","revoked"],"properties":{"credential_id":{"type":"string"},"project_id":{"type":"string"},"environment":{"type":"string"},"capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},"issued_at_utc":{"type":"string","format":"date-time"},"expires_at_utc":{"type":"string","format":"date-time"},"provenance":{"type":"string"},"revoked":{"type":"boolean"}},"additionalProperties":false}
  },
  "type":"object",
  "oneOf":[
    {"$ref":"#/$defs/controlDecision"},{"$ref":"#/$defs/humanIdentityAssertion"},{"$ref":"#/$defs/breakGlassGrant"},{"$ref":"#/$defs/schemaRecord"},{"$ref":"#/$defs/migrationRecord"},{"$ref":"#/$defs/capabilityEvidence"},{"$ref":"#/$defs/rolloutState"},{"$ref":"#/$defs/recoveryObjective"},{"$ref":"#/$defs/slo"},{"$ref":"#/$defs/supplyChainAttestation"},{"$ref":"#/$defs/credentialLease"}
  ]
}
