{
  "schema": "org-agent-mesh/new-project-bootstrap-kit/v1",
  "version": "1.2.0",
  "routing_contract_version": "1.5.0",
  "status": "ACTIVE",
  "purpose": "Seed a new project with isolated identity, durable coordination, fresh-agent orientation, autonomous continuation, recoverable handoff state, and the same project/role safety boundaries before or after repository binding.",
  "trigger": {"required": "EXPLICIT_HUMAN_REQUEST_TO_CREATE_OR_BOOTSTRAP_A_NEW_PROJECT", "implicit_topic_similarity": "DENY", "cross_project_guessing": "DENY"},
  "canonical_source": {"repository": "boberino93-bit/intercommunicationsenhancements", "protocol": "protocols/new_project_bootstrap.md", "handoff_protocol": "protocols/agent_state_handoff.md", "continuation_protocol": "protocols/autonomous_continuation.md", "fresh_agent_reference": "AGENT_CONTEXT_REFERENCE.md", "templates_root": "templates/new-project"},
  "seed_state": {"mode": "UNBOUND_PROJECT", "repository_binding": "UNBOUND", "github_required_to_start": false, "forum_authority": "INTERNAL_ARTIFACTORY", "forum_namespace_template": "{{PROJECT_ID}}::messages", "artifact_namespace_template": "{{PROJECT_ID}}::artifacts", "repository_view": {"mode": "NONE", "path": null}},
  "required_documents": [
    {"output": "AGENT_BOOTSTRAP.json", "template": "templates/new-project/AGENT_BOOTSTRAP.template.json"},
    {"output": "AGENT_CONTEXT_REFERENCE.md", "template": "templates/new-project/AGENT_CONTEXT_REFERENCE.template.md"},
    {"output": "PROJECT_IDENTITY_LOCK.json", "template": "templates/new-project/PROJECT_IDENTITY_LOCK.template.json"},
    {"output": "PROJECT_MANIFEST.json", "template": "templates/new-project/PROJECT_MANIFEST.template.json"},
    {"output": "BOOTSTRAP_ORDER.json", "template": "templates/new-project/BOOTSTRAP_ORDER.template.json"},
    {"output": "MASTER_HANDOFF.json", "template": "templates/new-project/MASTER_HANDOFF.template.json"},
    {"output": "START_HERE.md", "template": "templates/new-project/START_HERE.template.md"},
    {"output": "PROJECT_CHARTER.md", "template": "templates/new-project/PROJECT_CHARTER.template.md"},
    {"output": "HARDENING_STATUS.md", "template": "templates/new-project/HARDENING_STATUS.template.md"},
    {"output": "NEW_PROJECT_BOOTSTRAP.json", "template": "templates/new-project/NEW_PROJECT_BOOTSTRAP.template.json"}
  ],
  "required_directories": [".interagent/messages", ".interagent/directives", ".interagent/capacity", ".interagent/state", ".interagent/handoffs", ".swarm"],
  "identity_rules": {"copy_source_project_identity": false, "copy_source_repository_identity": false, "project_id_source": "EXPLICIT_HUMAN_NAME_OR_PROVISIONAL_SLUG_FROM_EXPLICIT_NEW_PROJECT_REQUEST", "repository_fields_while_unbound": {"full_name": null, "id": null}, "unknown_identity_action": "SEED_PROVISIONAL_IDENTITY_AND_MARK_PENDING_INSTEAD_OF_BINDING_TO_AN_EXISTING_PROJECT"},
  "startup_rules": {"identity_lock_first": true, "fresh_agent_reference_required": true, "fresh_agent_reference_authority": "ORIENTATION_ONLY", "master_handoff_before_mutation": true, "forum_before_mutation": true, "handoff_before_mutation": true, "recover_context_before_asking_human_to_repeat": true, "routine_confirmation": "DENY_AFTER_VALID_ASSIGNMENT", "fail_closed_scope": "AFFECTED_MUTATION_OR_BRANCH_ONLY", "continue_unaffected_safe_work": true, "communication_assessment_before_visibility_claim": true, "cross_project_write_default": "DENY", "source_project_is_reference_only": true},
  "repository_binding_lifecycle": {"initial": "UNBOUND", "allowed_unbound_work": ["project chartering", "internal forum setup", "artifact setup", "research", "planning", "bootstrap document generation", "master handoff maintenance", "fresh-agent context reference generation"], "github_mutation_while_unbound": "DENY", "bind_trigger": "EXPLICIT_REPOSITORY_CREATION_OR_CONNECTION", "bind_steps": ["verify repository full name and stable repository id", "update PROJECT_IDENTITY_LOCK.json", "update PROJECT_MANIFEST.json", "update AGENT_BOOTSTRAP.json repository block", "update AGENT_CONTEXT_REFERENCE.md project identity section", "update MASTER_HANDOFF.json source_state and authority mirror role", "update NEW_PROJECT_BOOTSTRAP.json source_project repository binding", "create repository mirror paths only after repository exists", "register project in PROJECT_ROLE_ROUTING_REGISTRY.json after identity verification", "record binding handoff in the new project's authoritative forum"]},
  "recursion": {"every_seeded_project_materializes_local_factory_pointer": true, "every_seeded_project_materializes_fresh_agent_reference": true, "future_project_bootstrap_source": "NEW_PROJECT_BOOTSTRAP.json", "canonical_templates_remain_centrally_managed": true},
  "completion_ack_template": "NEW PROJECT SEEDED: project=<project_id>; forum=<forum_namespace>; artifacts=<artifact_namespace>; context_reference=AGENT_CONTEXT_REFERENCE.md; master_handoff=MASTER_HANDOFF.json; repository_binding=UNBOUND; templates=<materialized_documents>; next=<autonomous_work_or_repository_binding>"
}
