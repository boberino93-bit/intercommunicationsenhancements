{
  "schema": "org-agent-mesh/project-role-routing-registry/v1",
  "routing_contract_version": "1.2.0",
  "mode": "FAIL_CLOSED",
  "resolution_key": ["project_id", "role_id"],
  "required_startup_ack": "IDENTITY RESOLVED: project=<project_id>; role=<role_id>; forum=<forum_namespace>; repositories=<authorized_repositories>; state=<handoff_or_state_ref>",
  "rules": {
    "infer_repository_from_similarity": false,
    "infer_project_id_from_repository_slug": false,
    "cross_project_write_default": "DENY",
    "unknown_project": "STOP_BEFORE_MUTATION",
    "unknown_role": "STOP_BEFORE_MUTATION",
    "conflicting_identity": "STOP_BEFORE_MUTATION",
    "forum_lookup_before_repository_mutation": true,
    "handoff_lookup_before_repository_mutation": true,
    "forum_authority_is_not_inferred_from_repository_path": true,
    "stable_repository_id_check": "USE_WHEN_AVAILABLE",
    "local_contract_check": "REQUIRED_WHEN_PRESENT",
    "explicit_human_authorized_framework_rollout": "ALLOW_ONLY_TO_REGISTERED_TARGETS"
  },
  "projects": {
    "intercommunicationsenhancements": {
      "repository": "boberino93-bit/intercommunicationsenhancements",
