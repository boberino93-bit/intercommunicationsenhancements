        "authority": "INTERNAL_ARTIFACTORY",
        "namespace": "intercommunicationsenhancements::messages",
        "repository_view": {"mode": "LIVE_MIRROR", "path": ".interagent/messages"}
      },
      "artifact_namespace": "intercommunicationsenhancements::artifacts",
      "handoff_paths": ["PROJECT_MANIFEST.json", "HARDENING_STATUS.md", "START_HERE.md"],
      "local_contract_path": "AGENT_BOOTSTRAP.json",
      "routing_contract_version": "1.2.0",
      "roles": ["primary", "manager", "research", "recovery", "qa", "build"]
    },
