{
  "schema": "org-agent-mesh/bootstrap-order/v3",
  "mode": "FAIL_CLOSED",
  "pre_provider_admission": {
    "protocol": "protocols/scheduled_agent_launch.md",
    "reference_runtime": "org_agent_mesh.launch_admission",
    "required_for_dynamic_scheduled_launches": true,
    "task_state_advancement_before_bootstrap_ready": "DENY",
    "retryable_prebootstrap_results": [
      "TOO_MANY_REQUESTS",
      "RATE_LIMITED",
      "TEMPORARY_PROVIDER_UNAVAILABLE",
      "TIMEOUT_BEFORE_BOOTSTRAP"
    ]
  },
  "steps": [
    {
      "order": 1,
      "id": "resolve_launch_origin_and_validate_project_intent",
      "active_project_context_policy": "USE_AS_STRONG_ROUTING_EVIDENCE_UNLESS_EXPLICIT_TARGET_CONFLICTS",
      "paths": ["protocols/scheduled_agent_launch.md", "protocols/universal_task_routing.md"],
      "launch_modes": {
        "INTERACTIVE_HUMAN": "validate_current_human_project_intent",
        "SCHEDULED_PROJECT_BOUND": "require_and_validate_launch_context_against_local_contract",
        "UNIVERSAL_UNBOUND": "remain_unbound_until_global_routing_resolves_exactly_one_project"
      },
      "scheduled_context_missing_or_conflicting": "STOP_BEFORE_MUTATION",
      "mutation_allowed": false
    },
    {"order": 2, "id": "load_and_validate_project_identity_lock", "path": "PROJECT_IDENTITY_LOCK.json", "mutation_allowed": false},
    {"order": 3, "id": "resolve_project_role_and_execution_mode", "paths": ["PROJECT_ROLE_ROUTING_REGISTRY.json", "bootstrap/PROJECT_ROLE_DISCOVERY.md"], "mutation_allowed": false},
    {"order": 4, "id": "validate_agent_package_manifest_against_identity_lock", "path": "AGENT_PACKAGE_MANIFEST.json", "mutation_allowed": false},
    {"order": 5, "id": "bind_execution_instance_to_project_role_and_mode", "mutation_allowed": false},
    {"order": 6, "id": "load_project_manifest_and_authority", "path": "PROJECT_MANIFEST.json", "mutation_allowed": false},
    {"order": 7, "id": "load_master_handoff", "path": "MASTER_HANDOFF.json", "protocol": "protocols/agent_state_handoff.md", "mutation_allowed": false},
    {"order": 8, "id": "load_project_handoffs_queues_forums_and_accepted_state", "selection_policy": "LOAD_ONLY_MASTER_HANDOFF_REFERENCED_STATE_NEEDED_FOR_CURRENT_TASK", "routing_guard": "PROJECT_ROLE_ROUTING_REGISTRY.json", "mutation_allowed": false},
    {"order": 9, "id": "assess_communication_visibility", "path": "protocols/communication_awareness.md", "required_ack": "COMMUNICATIONS ASSESSED", "mutation_allowed": false},
    {"order": 10, "id": "emit_identity_resolved_acknowledgement", "mutation_allowed": false},
    {"order": 11, "id": "mark_scheduled_occurrence_bootstrap_ready", "conditional": "launch_mode == SCHEDULED_PROJECT_BOUND", "path": "protocols/scheduled_agent_launch.md", "task_state_advancement_after_this_step": true, "mutation_allowed": false},
    {"order": 12, "id": "classify_task_and_bind_work_context", "path": "protocols/task_intake_and_delegation.md", "mutation_allowed": false},
    {"order": 13, "id": "load_swarm_learning_context", "path": "protocols/swarm_learning.md", "inheritance_order": ["operating_doctrine", "task_scoped_validated_knowledge", "raw_experience_on_demand_only"], "mutation_allowed": false},
    {"order": 14, "id": "load_swarm_launch_kernel_if_task_requires_swarm", "paths": ["SWARM_LAUNCH_KERNEL_V1.md", "swarm_kernel/project.json", "swarm_kernel/AGENT_BOOTSTRAP_OVERLAY.md"], "mutation_allowed": false, "conditional": "task_classification.swarm_participation == true"},
    {"order": 15, "id": "bind_global_run_role_instance_and_ready_barrier_if_swarm", "mutation_allowed": true, "conditional": "task_classification.swarm_participation == true"},
    {"order": 16, "id": "execute_task_with_per_mutation_scope_validation", "mutation_allowed": true, "additional_guards": ["project_role_registry_validation", "communication_namespace_conflict_block", "registered_repository_boundary", "master_handoff_loaded", "instance_fenced_lease_validation", "capacity_admission", "swarm_kernel_global_run_validation", "idempotency_validation", "manager_backpressure", "circuit_breaker", "learning_promotion_authority", "scheduled_occurrence_idempotency"]},
    {"order": 17, "id": "persist_learning_checkpoint_and_handoff", "path": "protocols/swarm_learning.md", "mutation_allowed": true, "conditional": "material_learning || completed_work_unit", "additional_guards": ["project_scope_validation", "idempotency_validation", "evidence_provenance_validation", "learning_promotion_authority"]},
    {"order": 18, "id": "manually_checkpoint_master_handoff_after_material_transition_or_before_yield", "path": "MASTER_HANDOFF.json", "protocol": "protocols/agent_state_handoff.md", "mutation_allowed": true, "conditional": "material_state_changed || yielding || handing_off"}
  ]
}
