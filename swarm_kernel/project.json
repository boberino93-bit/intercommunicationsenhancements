{
  "schema": "swarm-kernel/project/v1",
  "kernel_version": "1.2.1",
  "project_id": "intercommunicationsenhancements",
  "repository": "boberino93-bit/intercommunicationsenhancements",
  "canonical_branch": "main",
  "coordination_root": ".interagent/",
  "coordination_authority": "INTERNAL_ARTIFACTORY",
  "state_root": ".swarm",
  "swarm_state_authority": "PROJECT_LOCAL_OPERATIONAL_RECOVERY_STATE",
  "master_handoff_path": "MASTER_HANDOFF.json",
  "master_handoff_required_before_ready": true,
  "identity_source": "PROJECT_IDENTITY_LOCK.json",
  "required_bootstrap_overlays": [
    "swarm_kernel/AGENT_BOOTSTRAP_OVERLAY.md",
    "swarm_kernel/SELF_AUDIT_BOOTSTRAP_OVERLAY.md",
    "swarm_kernel/SWARM_SCALE_BOOTSTRAP_OVERLAY.md"
