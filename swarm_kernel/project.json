  "swarm_scale": {
    "entrypoint": "SWARM_SCALE_ENTRYPOINT.json",
    "protocol": "protocols/swarm_scale_100.md",
    "policy": "governance/SWARM_SCALE_100_POLICY.json",
    "target_population": 100,
    "stages": [15, 30, 60, 100],
