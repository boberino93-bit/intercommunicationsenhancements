  "self_audit": {
    "protocol": "governance/audit/AUDIT_PROTOCOL.md",
    "framework": "governance/audit/templates/AGENT_SELF_AUDIT_FRAMEWORK.md",
    "ledger_head": "governance/audit/LEDGER_HEAD.json",
    "framework_unavailable_result": "AUDIT_FRAMEWORK_UNAVAILABLE"
