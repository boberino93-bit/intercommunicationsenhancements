  "foreign_write_policy": "DENY_BY_DEFAULT",
  "cross_project_telemetry": "READ_ONLY",
  "lease_ttl_seconds": 1800,
  "heartbeat_interval_seconds": 300,
  "circuit_breaker_threshold": 3,
  "manager_queue_soft_limit": 8,
  "manager_queue_hard_limit": 15,
  "max_active_specialists": 8
