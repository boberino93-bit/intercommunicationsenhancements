    "scheduler_mutation_readback_required": true,
    "spawn_authority_is_not_mutation_authority": true,
    "scheduler_sync_is_not_project_mutation_authority": true,
    "scheduled_worker_continuation_integrity_required": true,
    "blocked_mutation_blocks_only_affected_branch": true,
    "blocker_finalization_requires_no_remaining_safe_work": true,
