{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-agent-mesh/epistemic-promotion-grant/v1-draft",
  "title": "IPG3 Epistemic Promotion Grant v1 Draft",
  "description": "Design-only, single-use authorization binding a validated trust promotion to one exact accepted-state effect. Generative output cannot mint this object by assertion alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "project_id",
    "record_id",
    "source_class",
    "target_class",
    "decision_id",
    "operation",
    "target_resource_id",
    "expected_version",
    "payload_sha256",
    "issuer",
    "validator_ids",
    "evidence_ids",
    "evidence_independence_keys",
    "issued_at_utc",
    "expires_at_utc",
    "max_uses",
    "status"
  ],
  "properties": {
    "schema": {"const": "org-agent-mesh/epistemic-promotion-grant/v1-draft"},
    "grant_id": {"$ref": "#/$defs/resourceId"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "record_id": {"$ref": "#/$defs/resourceId"},
    "source_class": {"$ref": "#/$defs/trustClass"},
    "target_class": {"$ref": "#/$defs/trustClass"},
    "decision_id": {"$ref": "#/$defs/resourceId"},
    "operation": {"type": "string", "minLength": 1},
    "target_resource_id": {"$ref": "#/$defs/resourceId"},
    "expected_version": {"type": "integer", "minimum": 0},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_instance_id", "role", "required_capabilities"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "agent_instance_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "validator_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_independence_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "max_uses": {"const": 1},
    "status": {"enum": ["ISSUED", "CONSUMED", "REVOKED", "EXPIRED"]}
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trustClass": {
      "enum": [
        "AUTHORITATIVE_CONFIG",
        "VERIFIED_FACT",
        "EXECUTION_EVIDENCE",
        "DERIVED_KNOWLEDGE",
        "AGENT_REFLECTION",
        "EXTERNAL_UNTRUSTED",
        "QUARANTINED"
      ]
    }
  }
}
