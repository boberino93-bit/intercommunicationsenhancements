    "role_capabilities": {
      "MANAGER": [
        "READ_SOURCE",
        "READ_ARTIFACTS",
        "WRITE_ARTIFACTS",
        "WRITE_WORKING_ARTIFACTS",
        "PUBLISH_MESSAGE",
        "CLAIM_TASK",
        "REVIEW_CHANGE"
      ],
      "PRIMARY": [
        "READ_SOURCE",
        "WRITE_SOURCE",
        "READ_ARTIFACTS",
        "WRITE_ARTIFACTS",
        "WRITE_WORKING_ARTIFACTS",
        "WRITE_ACCEPTED_STATE",
        "PUBLISH_MESSAGE",
        "CLAIM_TASK",
        "REVIEW_CHANGE",
        "APPROVE_CHANGE",
        "CONTROL_PROJECT_LIFECYCLE",
        "SEND_EXTERNAL_COMMUNICATION",
        "APPROVE_RELEASE",
        "CROSS_PROJECT_EXCHANGE",
        "BUILD_DEPLOYMENT_PACKAGE",
        "PUBLISH_DEPLOYMENT_PACKAGE"
      ],
      "RESEARCH": [
        "READ_SOURCE",
        "READ_ARTIFACTS",
        "WRITE_ARTIFACTS",
        "WRITE_WORKING_ARTIFACTS",
        "PUBLISH_MESSAGE",
        "CLAIM_TASK"
      ]
    },
    "roles": {
      "MANAGER": "REVIEWER",
      "PRIMARY": "ORCHESTRATOR",
      "RESEARCH": "SPECIALIST"
    }
  },
  "bootstrap_order_path": "BOOTSTRAP_ORDER.json",
