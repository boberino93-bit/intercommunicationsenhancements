  "schema": "org-agent-mesh/project-identity-lock/v2",
  "task_root": ".interagent/tasks",
  "writable_repository": "boberino93-bit/intercommunicationsenhancements",
  "write_policy": {
    "caller_supplied_identity": "UNTRUSTED",
    "cross_project_writes": "DENY_BY_DEFAULT",
