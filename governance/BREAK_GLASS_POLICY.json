{
  "schema": "intercommunications/break-glass-policy/v1",
  "version": "1.0.0",
  "status": "ACTIVE_HARD_GATE",
  "core_invariant": "BREAK_GLASS_IS_NOT_AN_AUTHORIZATION_BYPASS",
  "requires_normal_security_controls": true,
  "requires_fresh_security_token": true,
  "security_token": {
    "single_use": true,
    "short_lived": true,
    "scope_bound": true,
    "principal_bound": true,
    "project_bound": true,
    "target_bound": true,
    "action_digest_bound": true,
    "consequence_class_bound": true,
    "non_transferable": true,
    "deny_on_expiry": true,
    "deny_on_replay": true,
    "deny_on_scope_change": true,
    "deny_on_target_change": true,
    "deny_on_action_digest_change": true,
    "raw_token_in_url_allowed": false,
    "raw_token_in_handoff_allowed": false,
    "raw_token_in_commit_message_allowed": false,
    "raw_token_in_durable_summary_allowed": false
  },
  "required_controls": [
    "EXPLICIT_PRINCIPAL_CLAIM",
    "REGISTERED_PRINCIPAL_MATCH",
    "FRESH_SINGLE_USE_AUTHORIZATION_CASE",
    "HIGH_CONSEQUENCE_EXTERNAL_PROOF_WHEN_APPLICABLE",
    "FRESH_BREAK_GLASS_SECURITY_TOKEN",
    "EXACT_PROJECT_BINDING",
    "ROLE_AND_CAPABILITY_ELIGIBILITY",
    "LEASE_CLAIM_AND_FENCE_VALIDATION",
    "REVISION_AND_STALE_STATE_VALIDATION",
    "HOLD_AND_QUARANTINE_EVALUATION",
    "ACTION_DIGEST_AND_SCOPE_MATCH",
    "REPLAY_AND_NONCE_VALIDATION",
    "AUDIT_LOGGING",
    "BACKUP_AND_ROLLBACK_REQUIREMENTS",
    "POST_ACTION_VALIDATION"
  ],
  "forbidden_effects": [
    "PROMOTE_RESEARCH_TO_MANAGER",
    "PROMOTE_RESEARCH_TO_PRIMARY",
    "PROMOTE_MANAGER_TO_PRIMARY",
    "CREATE_CROSS_PROJECT_AUTHORITY",
    "CREATE_HUMAN_ROOT_AUTHORITY",
    "CONVERT_READ_ONLY_TO_MUTATION_AUTHORITY",
    "OVERRIDE_PROJECT_LOCALITY",
    "REVIVE_EXPIRED_AUTHORITY",
    "BYPASS_SECURITY_CONTROL"
  ],
  "missing_or_invalid_token_result": "DENY_BREAK_GLASS_CONTINUE_SAFE_READ_ONLY",
  "protocol": "protocols/break_glass_security.md"
}
