{
  "schema":"org-agent-mesh/scheduler-control-interface/v1",
  "version":"1.2.0",
  "status":"ACTIVE",
  "purpose":"Provide a low-prompt natural-language control surface over the synchronized backend scheduler, ChatGPT frontend Scheduled Tasks, and fast multi-project operational glance without merging authority domains.",
  "surfaces":{
    "internal_scheduler":{"authority":"GITHUB_CONTROL_PLANE","schedule_registry":"governance/INTERNAL_SPAWN_SCHEDULES.json","policy":"governance/INTERNAL_SPAWN_SCHEDULER_POLICY.json"},
    "chatgpt_automations":{"authority":"CHATGPT_AUTOMATIONS","state_source":"AUTOMATIONS_TOOL","separate_execution_ledger":true},
    "synchronization":{"directive":"governance/SCHEDULER_SYNCHRONIZATION_DIRECTIVE.json","bindings":"governance/SCHEDULER_FRONTEND_BINDINGS.json"},
    "project_glance":{"interface":"governance/PROJECT_GLANCE_INTERFACE.json","cache":"PROJECT_GLANCE_INDEX.json","authority":"READ_ONLY_DERIVED_CACHE"}
  },
  "commands":{
    "scheduler status":{"action":"READ_RECONCILED_STATUS","mutation":false},
    "scheduler health":{"action":"FORENSIC_HEALTH_AND_DRIFT_CHECK","mutation":false},
    "scheduler reconcile":{"action":"RECONCILE_DECLARED_MAPPINGS_NOW","requires_explicit_current_human_command":true},
    "scheduler pause":{"action":"PAUSE_ALL_MAPPED_SYSTEM_SCHEDULER_JOBS_BOTH_SURFACES","requires_explicit_current_human_command":true},
    "scheduler resume":{"action":"RESUME_ALL_MAPPED_SYSTEM_SCHEDULER_JOBS_BOTH_SURFACES","requires_explicit_current_human_command":true},
    "scheduler pause internal":{"action":"DISABLE_INTERNAL_JOB_ONLY","requires_explicit_current_human_command":true},
    "scheduler resume internal":{"action":"ENABLE_INTERNAL_JOB_ONLY","requires_explicit_current_human_command":true},
    "scheduler pause bridge":{"action":"PAUSE_CHATGPT_BOOTSTRAP_SPAWN_BRIDGE_ONLY","requires_explicit_current_human_command":true},
    "scheduler resume bridge":{"action":"RESUME_CHATGPT_BOOTSTRAP_SPAWN_BRIDGE_ONLY","requires_explicit_current_human_command":true},
    "scheduler run":{"action":"RUN_MAPPED_BOOTSTRAP_BRIDGE_NOW","requires_explicit_current_human_command":true},
    "scheduler account":{"action":"LIST_CHATGPT_AUTOMATIONS_COMPACT","mutation":false},
    "scheduler internal":{"action":"LIST_INTERNAL_JOBS_COMPACT","mutation":false},
    "scheduler legacy":{"action":"LIST_FRONTEND_ONLY_LEGACY_CAPACITY_TASKS","mutation":false},
    "scheduler personal":{"action":"LIST_FRONTEND_ONLY_PERSONAL_TASKS","mutation":false},
    "scheduler route <project_id>":{"action":"SET_INTERNAL_PROJECT_FILTER","requires_explicit_current_human_command":true,"must_match_registered_project":true},
    "scheduler route global":{"action":"CLEAR_INTERNAL_PROJECT_FILTER","requires_explicit_current_human_command":true},
    "scheduler restore defaults":{"action":"RESTORE_CANONICAL_MAPPED_SYSTEM_DEFAULTS_BOTH_SURFACES","requires_explicit_current_human_command":true},
    "project status":{"action":"READ_PROJECT_GLANCE_INDEX","mutation":false},
    "project status <project_id>":{"action":"READ_ONE_PROJECT_GLANCE_REFRESH_IF_STALE","mutation":false},
    "projects refresh":{"action":"REFRESH_SANITIZED_PROJECT_GLANCE_CACHE","requires_explicit_current_human_command":true}
  },
  "natural_language_aliases":{
    "what is running":"scheduler status",
    "how many agents are running":"scheduler status",
    "show schedules":"scheduler status",
    "check scheduler":"scheduler health",
    "sync schedulers":"scheduler reconcile",
    "stop scheduler":"scheduler pause",
    "start scheduler":"scheduler resume",
    "how are the projects":"project status",
    "what is going on with the projects":"project status",
    "give me the project overview":"project status",
    "what is going on with <project_id>":"project status <project_id>"
  },
  "response_contract":{
    "default":"COMPACT",
    "show_confirmed_running":true,
    "show_enabled_scheduled":true,
    "show_paused_count":true,
    "show_next_due":true,
    "show_last_result":true,
    "show_drift":true,
    "separate_backend_frontend_and_mapped_logical_jobs":true,
    "project_status_uses_cache_first":true,
    "project_status_deep_reads_only_stale_conflicting_or_requested_entries":true,
    "do_not_dump_full_prompts_unless_requested":true,
    "one_line_summary_first":true
  },
  "safety":{
    "status_command_is_never_mutation":true,
    "declared_mapping_required_for_cross_surface_mutation":true,
    "unmapped_personal_tasks_cannot_be_changed_by_scheduler_commands":true,
    "project_glance_is_not_project_authority":true,
    "primary_master_full_swarm_prohibitions_unchanged":true,
    "spawn_authority_is_not_mutation_authority":true,
    "task_mapping_is_not_project_authority":true
  }
}
