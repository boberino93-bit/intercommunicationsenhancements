{
  "schema": "org-agent-mesh/mutation-authorization/v2",
  "version": "2.0.0",
  "status": "ACTIVE_HARD_GATE",
  "invariant": "INTENT_IS_NOT_AUTHORIZATION",
  "authority_authentication_policy": "governance/AUTHORITY_AUTHENTICATION_POLICY.json",
  "authority_authentication_protocol": "protocols/authority_authentication.md",
  "mutation_definition": [
    "REPOSITORY_OR_FILE_WRITE",
    "COMMIT_OR_MERGE",
    "PULL_REQUEST_STATE_CHANGE",
    "ISSUE_OR_COMMENT_PUBLICATION",
    "ARTIFACT_PUBLICATION",
    "DEPLOYMENT_OR_RELEASE",
    "SCHEDULED_TASK_STATE_CHANGE",
    "PERSISTENT_FORUM_OR_MESSAGE_WRITE",
    "PRODUCTION_OR_CONFIGURATION_CHANGE",
    "OTHER_EXTERNALLY_DURABLE_SIDE_EFFECT"
  ],
  "valid_authorization_sources": [
    "CURRENT_HUMAN_SINGLE_USE_AUTHORIZATION_CASE"
  ],
  "invalid_authorization_sources": [
    "INFERRED_INTENT",
    "CAPABILITY_QUESTION",
    "DESIGN_DISCUSSION",
    "ENTHUSIASM_OR_PRAISE",
    "ROLE_OR_SENIORITY",
    "PROJECT_OWNERSHIP",
    "TOOL_AVAILABILITY",
    "REPOSITORY_PERMISSION",
    "URGENCY",
    "EXPECTED_USEFULNESS",
    "PRIOR_AUTHORIZATION",
    "PRIOR_AUTHENTICATION",
    "ACTIVE_TASK_CONTRACT_ALONE",
    "SCHEDULE_FIRE",
    "PARENT_AGENT_DELEGATION_ALONE",
    "SESSION_CONTEXT",
    "CONVERSATION_CONTINUITY"
  ],
  "principal_claim_required": true,
  "authorization_record_required_before_each_mutation_case": true,
  "authorization_case": {
    "case_id_required": true,
    "human_authorization_must_reference_case_id": true,
    "single_use": true,
    "default_expiry_minutes": 15,
    "session_persistence": false,
    "conversation_persistence": false,
    "project_persistence": false,
    "schedule_persistence": false,
    "replay_result": "DENY",
    "material_scope_change_requires_new_case": true,
    "target_change_requires_new_case": true,
    "mutation_class_change_requires_new_case": true,
    "consequence_class_change_requires_new_case": true
  },
  "authorization_record_fields": [
    "case_id",
    "source_class",
    "claimed_principal",
    "authentication_disposition",
    "target_scope",
    "mutation_class",
    "bounded_scope",
    "consequence_class",
    "action_digest",
    "issued_at",
    "expires_at",
    "consumed_at_or_null",
    "fits_authorization_case"
  ],
  "high_consequence_rule": "REQUIRE_INDEPENDENT_PRINCIPAL_PROOF_AND_SINGLE_USE_CASE",
  "high_consequence_classes": [
    "ROOT_AUTHORITY_CHANGE",
    "UNIVERSAL_GOVERNANCE_CHANGE",
    "PRODUCTION_PROMOTION_OR_DEPLOYMENT",
    "SECURITY_OR_CREDENTIAL_BOUNDARY_CHANGE",
    "FINANCIAL_EFFECT",
    "DESTRUCTIVE_OR_IRREVERSIBLE_OPERATION",
    "SCHEDULE_ENABLE_OR_REENABLE",
    "CROSS_PROJECT_MUTATION"
  ],
  "fail_closed": {
    "deny_affected_write": true,
    "continue_safe_read_only_work": true,
    "preserve_state": true,
    "surface_exact_blocked_mutation": true,
    "request_case_specific_authorization_only_when_mutation_required": true
  },
  "scheduled_work": {
    "schedule_fire_is_authorization": false,
    "task_contract_is_future_mutation_authorization": false,
    "each_distinct_mutation_case_requires_fresh_human_authorization": true,
    "read_only_scheduled_work_without_case": true
  },
  "delegation": {
    "may_narrow_execution_scope_within_same_case": true,
    "may_create_new_human_authorization": false,
    "may_expand_case_scope": false,
    "distinct_mutation_requires_new_case": true
  },
  "role_is_mutation_authority": false,
  "claim_or_lease_is_mutation_authority": false,
  "authentication_is_mutation_authority": false,
  "audit_minimum": [
    "case_id",
    "claimed_principal",
    "authentication_disposition",
    "operation_class",
    "target_scope",
    "authorization_disposition",
    "governing_rule",
    "write_prevented",
    "case_consumed",
    "corrective_action"
  ]
}
