  "distribution": {
    "strategy": "EVEN_10_MINUTE_STAGGER",
    "capacity_lanes_per_hour": 6,
    "minimum_lane_spacing_minutes": 10,
    "grace_minutes": 9,
    "frontend_execution_mapped": true,
