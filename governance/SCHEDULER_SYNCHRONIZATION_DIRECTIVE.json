{
  "schema": "org-agent-mesh/scheduler-synchronization-directive/v1",
  "version": "1.3.0",
  "status": "ACTIVE_BY_EXPLICIT_HUMAN_DIRECTIVE_2026-10-07",
  "directive": "Maintain synchronicity between canonical backend scheduler jobs and mapped ChatGPT frontend Scheduled Tasks while preserving separate authority, execution, audit, and account-capacity ledgers.",
  "surfaces": {
    "backend": {
      "canonical_registry": "governance/INTERNAL_SPAWN_SCHEDULES.json",
      "policy": "governance/INTERNAL_SPAWN_SCHEDULER_POLICY.json",
      "clock": ".github/workflows/internal-spawn-scheduler.yml"
    },
    "frontend": {
      "provider": "CHATGPT_AUTOMATIONS",
      "state_source": "Automations",
      "mapping_registry": "governance/SCHEDULER_FRONTEND_BINDINGS.json"
    }
  },
  "reconciler_authority": {
    "mode": "SINGLE_DECLARED_FRONTEND_RECONCILER",
    "frontend_automation_id": "6ac63d38cc688191b9de4213ca40f951",
    "frontend_title": "Bootstrap Spawn Bridge",
    "ordinary_capacity_workers_may_mutate_scheduler_state": false,
    "ordinary_capacity_workers_may_create_frontend_tasks": false,
    "ordinary_capacity_workers_may_disable_or_enable_frontend_tasks": false,
    "ordinary_capacity_workers_may_reschedule_or_rename_frontend_tasks": false,
    "ordinary_capacity_workers_scheduler_role": "READ_DETECT_REPORT_ONLY",
    "reconciler_may_update_only_existing_declared_frontend_automation_ids": true,
    "reconciler_may_create_replacement_tasks": false,
    "reconciler_may_delete_tasks": false,
    "missing_declared_frontend_task_action": "SCHEDULER_SYNC_CONFLICT_REQUIRE_EXPLICIT_HUMAN_REPLACEMENT_AUTHORIZATION",
    "duplicate_title_does_not_establish_identity": true,
    "conversation_id_does_not_establish_binding": true
  },
  "reconciliation": {
    "mode": "DECLARED_MAPPING_ONLY",
    "backend_is_schedule_intent_source_for_mapped_system_jobs": true,
    "frontend_is_execution_state_source_for_chatgpt_tasks": true,
    "bidirectional_drift_detection": true,
    "automatic_repair_authorized_for_mapped_non_destructive_fields": true,
    "automatic_repair_actor_must_match_declared_reconciler": true,
    "automatic_fields": [
      "title",
      "schedule",
      "timezone"
    ],
    "enabled_state_transition_gate": "org_agent_mesh.schedule_activation",
    "disabled_to_enabled_requires_explicit_current_human_authorization": true,
    "capacity_availability_is_not_activation_authorization": true,
    "mirror_policy_may_not_auto_enable": true,
    "supported_enabled_state_policies": [
      "MIRROR",
      "MIRROR_WHEN_ACCOUNT_CAPACITY_AVAILABLE",
      "MIRROR_DISABLED_STANDBY",
      "FRONTEND_ONLY"
    ],
    "account_capacity_limit_is_a_first_class_constraint": true,
    "capacity_limit_deferred_enablement": "REPORT_READY_FOR_HUMAN_ENABLEMENT_AFTER_CAPACITY_RELEASE",
    "capacity_release_does_not_enable_task": true,
    "capacity_limit_deferred_is_not_conflict": true,
    "standby_binding_remains_disabled_until_canonical_state_changes": true,
    "never_infer_mapping_by_title_similarity": true,
    "never_create_frontend_task_as_automatic_repair": true,
    "never_delete_frontend_task_as_automatic_repair": true,
    "never_import_unmapped_personal_frontend_tasks_into_backend": true,
    "never_delete_unmapped_frontend_tasks": true,
    "preserve_frontend_task_identity": true,
    "preserve_backend_job_identity": true,
    "missing_or_unavailable_identity_disposition": "REPLACEMENT_AUTHORIZATION_REQUIRED",
    "stale_execution_disposition": "REPORT_STALE_EXECUTION_WITHOUT_IDENTITY_REPLACEMENT",
    "replacement_requires_explicit_current_human_authorization": true,
    "replacement_must_preserve_enabled_state_unless_activation_is_separately_authorized": true,
    "conflict_action": "FAIL_CLOSED_AFFECTED_BINDING_AND_REPORT_SCHEDULER_SYNC_CONFLICT"
  },
  "control": {
    "human_can_pause_resume_or_reconfigure_mapped_job_from_either_surface": true,
    "declared_reconciler_must_propagate_authorized_mapped_change": true,
    "unmapped_personal_tasks_remain_frontend_only": true,
    "internal_only_jobs_are_allowed": true,
    "frontend_only_tasks_are_allowed": true,
    "synchronization_does_not_expand_worker_mutation_authority": true
  },
  "safety": {
    "primary_spawn_prohibited": true,
    "master_spawn_prohibited": true,
    "full_swarm_auto_start_prohibited": true,
    "spawn_authority_is_not_mutation_authority": true,
    "task_mapping_is_not_project_authority": true,
    "scheduler_sync_may_not_modify_project_domain_state": true,
    "scheduler_reconciliation_authority_is_not_inherited_by_scheduled_workers": true
  }
}
