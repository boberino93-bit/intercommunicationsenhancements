{
  "schema": "org-agent-mesh/layered-context-policy/v1",
  "policy_id": "IEP-CTX-001",
  "version": "1.0.0",
  "status": "ACTIVE",
  "scope": "GLOBAL_ALL_AGENT_TYPES",
  "title": "Context is pervasive, layered, and provenance-bound",
  "bootstrap_invariant": "CONTEXT_IS_PRESENT_IN_EVERY_OBSERVABLE_INPUT_AND_MAY_EXIST_AT_MULTIPLE_LAYERS",
  "rules": {
    "absence_in_one_layer_proves_global_absence": false,
    "scan_available_authorized_layers_before_declaring_context_missing": true,
    "scan_available_authorized_layers_before_asking_human_to_repeat": true,
    "preserve_layer_provenance": true,
    "preserve_temporal_state": true,
    "preserve_material_contradictions": true,
    "authority_is_separate_from_context_presence": true,
    "repetition_is_not_independent_corroboration": true,
    "do_not_infer_inaccessible_hidden_context": true,
    "current_explicit_human_instruction_has_task_intent_precedence": true,
    "project_binding_and_mutation_authority_still_require_their_own_contracts": true
  },
  "context_layers": [
    "current_human_message",
    "current_conversation_history",
    "host_project_binding",
    "attachments_and_images",
    "tool_outputs_and_connector_results",
    "scheduled_launch_context",
    "project_bootstrap_and_identity_contracts",
    "master_and_project_handoffs",
    "canonical_artifactory_agentbus_state",
    "registered_github_repository_state",
    "task_claims_leases_and_fences",
    "runtime_and_ui_state",
    "temporal_evidence_labels",
    "validated_learning_and_governance_records"
  ],
  "resolution_order": [
    "identify_all_context-bearing layers actually available to this agent",
    "tag each material datum with source layer, time/state, project, and authority class where known",
    "deduplicate repeated facts without treating repetition as independent evidence",
    "reconcile conflicts using explicit authority, project-binding, temporal, and provenance rules",
    "retain unresolved contradictions instead of flattening them",
    "only then determine whether information is genuinely missing"
  ],
  "native_chatgpt_memory_boundary": {
    "policy_id": "IEP-MEM-001",
    "may_be_swarm_authority": false,
    "may_be_queried_as_swarm_fallback": false,
    "host_supplied_ephemeral_context_may_be_observed": true,
    "host_supplied_ephemeral_context_requires_external_verification_for_swarm_authority_claims": true
  },
  "implementation": {
    "protocol": "protocols/layered_context_resolution.md",
    "startup_reference": "AGENT_CONTEXT_REFERENCE.md",
    "directive": ".interagent/directives/2026-10-07-layered-context-awareness.json",
    "test": "tests/test_layered_context_directive.py"
  }
}
