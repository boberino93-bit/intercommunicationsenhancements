{
  "schema": "org-agent-mesh/internal-spawn-scheduler-policy/v1",
  "version": "1.8.0",
  "status": "ACTIVE_BY_EXPLICIT_HUMAN_REQUEST",
  "service": {
    "enabled": true,
    "clock": "INDEPENDENT_HOST_SCHEDULER",
    "reference_runtime": "org_agent_mesh.internal_scheduler",
    "reconciliation_runtime": "org_agent_mesh.scheduler_reconciliation",
    "protocol": "protocols/internal_scheduler_service.md",
    "schedule_registry": "governance/INTERNAL_SPAWN_SCHEDULES.json",
    "ticket_schema": "schemas/scheduled_spawn_ticket.schema.json",
    "host_adapter_required_for_real_spawn": true,
    "spawn_ticket_is_session_started": false,
    "host_start_receipt_required_for_session_started": true,
    "scheduler_sync_directive": "governance/SCHEDULER_SYNCHRONIZATION_DIRECTIVE.json",
    "frontend_binding_registry": "governance/SCHEDULER_FRONTEND_BINDINGS.json",
    "scheduler_activation_grant": "governance/SCHEDULER_ACTIVATION_GRANT_2026-10-07.json",
    "continuation_integrity_protocol": "protocols/scheduled_continuation_integrity.md",
    "autonomous_continuation_protocol": "protocols/autonomous_continuation.md"
  },
  "delegated_spawn_authority": {
    "authorization_basis": "EXPLICIT_CURRENT_HUMAN_REQUEST_2026-10-07",
    "allowed_roles": ["research", "manager"],
    "primary_allowed": false,
    "master_allowed": false,
    "full_swarm_auto_start_allowed": false,
    "max_workers_per_occurrence": 1,
    "max_tickets_per_scheduler_invocation": 1,
    "project_binding_required_before_protected_work": true,
    "spawn_authority_is_not_mutation_authority": true,
    "role_or_ticket_is_not_mutation_authority": true
  },
  "execution_surface_isolation": {
    "exactly_one_execution_surface_per_occurrence": true,
    "allowed_surfaces": ["CHATGPT_FRONTEND_MAPPED", "BACKEND_HOST_ADAPTER"],
    "frontend_mapped_backend_webhook_dispatch": false,
    "backend_host_adapter_frontend_execution": false,
    "frontend_mapped_backend_disposition": "FRONTEND_EXECUTION_EXPECTED",
    "frontend_mapped_backend_adapter_result": "BACKEND_DISPATCH_SUPPRESSED_FRONTEND_MAPPED",
    "backend_host_dispatch_requires_explicit_execution_surface": true,
    "duplicate_cross_surface_execution_prohibited": true
  },
  "continuation_integrity": {
    "required_for_scheduled_workers": true,
    "blocked_action_blocks_only_affected_branch": true,
    "must_exhaust_useful_safe_in_scope_work_before_blocker_finalization": true,
    "authorization_blocked_mutation_must_not_end_read_only_safe_work": true,
    "prepare_non_mutating_execution_artifact_when_useful": true,
    "safe_reversible_assumptions_may_continue_when_authority_and_scope_unchanged": true,
    "remaining_safe_work_must_be_false_for_blocker_terminal_outcome": true,
    "work_advanced_may_coexist_with_secondary_blocker": true,
    "human_decision_required_only_when_no_useful_safe_work_remains": true,
    "capability_blocked_only_after_permitted_fallbacks_and_safe_work_exhausted": true,
    "checkpoint_io_blocked_does_not_erase_completed_useful_work": true,
    "continuation_may_not_cross_project_or_claim_new_work_unit": true,
    "continuation_does_not_grant_mutation_authority": true,
    "hold_pause_stop_override_continuation": true,
    "resource_exhaustion_requires_best_available_handoff_when_practical": true,
    "unfinished_safe_work_survives_invocation_boundary": true,
    "unfinished_work_must_not_be_marked_completed": true,
    "successor_must_scan_valid_unresolved_continuation_handoffs_before_lower_priority_fresh_work": true,
    "successor_resume_requires_project_role_claim_fence_and_control_revalidation": true,
    "higher_priority_p0_p3_work_may_preempt_continuation": true,
    "live_owner_prevents_duplicate_continuation": true,
    "handoff_transfers_context_not_authority": true
  },
  "scheduler_state_boundary": {
    "synchronization_authorized_by_human_directive": true,
    "declared_mapping_required": true,
    "may_reconcile_mapped_chatgpt_scheduled_tasks": true,
    "declared_frontend_reconciler_automation_id": "6ac63d38cc688191b9de4213ca40f951",
    "declared_frontend_reconciler_title": "Bootstrap Spawn Bridge",
    "secondary_liveness_reconciler_automation_id": "6ac3779cb1008191b636d39bd59553d8",
    "secondary_liveness_reconciler_title": "Swarm Capacity Slot 1",
    "repair_authorization_ref": "governance/SCHEDULER_ACTIVATION_GRANT_2026-10-07.json",
    "ordinary_capacity_workers_scheduler_state_access": "READ_DETECT_REPORT_ONLY",
    "ordinary_capacity_workers_may_mutate_scheduler_state": false,
    "secondary_liveness_reconciler_is_explicit_exception_to_ordinary_worker_fence": true,
    "secondary_liveness_reconciler_may_enable_existing_declared_targets_only": true,
    "secondary_liveness_reconciler_may_disable_tasks": false,
    "secondary_liveness_reconciler_may_create_delete_replace_rename_or_reschedule": false,
    "automatic_repair_actor_must_match_declared_reconciler_or_liveness_sentinel": true,
    "reconciler_may_update_only_existing_declared_frontend_ids": true,
    "reconciler_may_create_replacement_frontend_tasks": false,
    "reconciler_may_delete_frontend_tasks": false,
    "enabled_state_transition_gate": "org_agent_mesh.schedule_activation",
    "may_enable_mapped_chatgpt_task_when_binding_policy_is_MIRROR": true,
    "may_enable_mapped_chatgpt_task_when_binding_policy_is_MIRROR_WHEN_ACCOUNT_CAPACITY_AVAILABLE": true,
    "enable_repair_requires_active_scoped_human_authorization": true,
    "disabled_to_enabled_requires_direct_human_request_or_active_scoped_human_repair_grant": true,
    "capacity_availability_is_not_activation_authorization": true,
    "may_disable_mapped_chatgpt_task_when_binding_policy_is_MIRROR": true,
    "must_keep_MIRROR_DISABLED_STANDBY_disabled": true,
    "account_capacity_rejection_is_CAPACITY_LIMIT_DEFERRED": true,
    "capacity_deferred_enablement_may_retry_after_capacity_release_under_active_repair_grant": true,
    "capacity_release_action": "RETRY_IF_ACTIVE_SCOPED_HUMAN_REPAIR_GRANT_ELSE_REPORT_READY_FOR_HUMAN_ENABLEMENT",
    "direct_frontend_toggle_without_canonical_control_event_is_execution_state_not_durable_intent": true,
    "canonical_pause_or_backend_disabled_revokes_repair_for_affected_job": true,
    "may_reschedule_mapped_chatgpt_task_to_canonical_backend_schedule": true,
    "may_rename_mapped_chatgpt_task_to_declared_frontend_title": true,
    "may_modify_unmapped_chatgpt_tasks": false,
    "may_create_or_delete_unmapped_chatgpt_tasks": false,
    "may_infer_mapping_from_title_similarity": false,
    "duplicate_title_does_not_establish_identity": true,
    "missing_mapped_task_requires_human_replacement_authorization": true,
    "unavailable_mapped_task_requires_human_replacement_authorization": true,
    "stale_execution_is_not_replacement_authority": true,
    "replacement_must_preserve_enabled_state_unless_activation_is_separately_authorized": true,
    "personal_frontend_tasks_remain_frontend_control": true,
    "scheduler_sync_does_not_expand_project_mutation_authority": true
  },
  "admission": {
    "reference": "org_agent_mesh.launch_admission",
    "provider_admission_required": true,
    "max_inflight": 1,
    "minimum_start_spacing_seconds": 30,
    "retryable_prebootstrap_results": [
      "TOO_MANY_REQUESTS",
      "RATE_LIMITED",
      "TEMPORARY_PROVIDER_UNAVAILABLE",
      "TIMEOUT_BEFORE_BOOTSTRAP"
    ],
    "catch_up_policy": "COALESCE_TO_LATEST",
    "blind_historical_replay": false
  },
  "failure_semantics": {
    "adapter_missing": "SPAWN_ADAPTER_UNAVAILABLE",
    "adapter_rejected": "SPAWN_ADAPTER_REJECTED",
    "adapter_accepted_without_start_receipt": "DISPATCH_ACCEPTED_START_UNVERIFIED",
    "provider_rejected_before_bootstrap": "LAUNCH_PROVIDER_ADMISSION_FAILED",
    "ticket_created_without_host_receipt": "SPAWN_TICKET_PENDING",
    "scheduler_mapping_conflict": "SCHEDULER_SYNC_CONFLICT",
    "frontend_state_unavailable": "FRONTEND_SCHEDULER_STATE_UNAVAILABLE",
    "frontend_account_capacity_full": "CAPACITY_LIMIT_DEFERRED",
    "frontend_activation_gate": "ENABLE_AUTHORIZATION_REQUIRED",
    "frontend_liveness_repair_denied": "ENABLE_AUTHORIZATION_REQUIRED",
    "frontend_identity_missing_or_unavailable": "REPLACEMENT_AUTHORIZATION_REQUIRED",
    "frontend_execution_stale": "STALE_EXECUTION_REPORTED",
    "frontend_mapped_backend_dispatch_suppressed": "FRONTEND_EXECUTION_EXPECTED",
    "premature_blocker_finalization": "CONTINUATION_INTEGRITY_VIOLATION",
    "unfinished_work_abandoned_at_invocation_boundary": "CONTINUATION_HANDOFF_MISSING",
    "unauthorized_scheduler_state_mutation_attempt": "SCHEDULER_MUTATION_ACTOR_PROHIBITED",
    "unmapped_duplicate_detected": "SCHEDULER_SYNC_CONFLICT",
    "never_call_capacity_limit_deferred_task_failed": true,
    "never_call_missing_adapter_task_failed": true,
    "never_claim_spawn_from_ticket_alone": true
  },
  "observability": {
    "record_scheduled_for": true,
    "record_observed_at": true,
    "record_occurrence_id": true,
    "record_ticket_id": true,
    "record_adapter_result": true,
    "record_start_receipt": true,
    "record_bootstrap_ready_separately": true,
    "record_final_outcome_separately": true,
    "record_frontend_binding_id": true,
    "record_frontend_observed_state": true,
    "record_frontend_identity_health": true,
    "record_frontend_last_run_time": true,
    "record_backend_canonical_state": true,
    "record_sync_disposition": true,
    "record_activation_gate_disposition": true,
    "record_repair_authorization_ref": true,
    "record_repair_actor": true,
    "record_replacement_gate_disposition": true,
    "record_capacity_deferred_state": true,
    "record_scheduler_mutation_actor": true,
    "record_execution_surface": true,
    "record_backend_dispatch_attempt_count": true,
    "record_frontend_mapped_execution_count": true,
    "record_blocked_actions": true,
    "record_safe_fallbacks_considered": true,
    "record_safe_fallbacks_completed": true,
    "record_remaining_safe_work_at_finalization": true,
    "record_continuation_handoff_required": true,
    "record_continuation_handoff_ref": true,
    "record_successor_acceptance_when_resumed": true,
    "record_remaining_human_gate": true
  }
}
