{
  "schema": "org-agent-mesh/internal-spawn-scheduler-policy/v1",
  "version": "1.1.0",
  "status": "ACTIVE_BY_EXPLICIT_HUMAN_REQUEST",
  "service": {
    "enabled": true,
    "clock": "INDEPENDENT_HOST_SCHEDULER",
    "reference_runtime": "org_agent_mesh.internal_scheduler",
    "protocol": "protocols/internal_scheduler_service.md",
    "schedule_registry": "governance/INTERNAL_SPAWN_SCHEDULES.json",
    "ticket_schema": "schemas/scheduled_spawn_ticket.schema.json",
    "host_adapter_required_for_real_spawn": true,
    "spawn_ticket_is_session_started": false,
    "host_start_receipt_required_for_session_started": true,
    "scheduler_sync_directive": "governance/SCHEDULER_SYNCHRONIZATION_DIRECTIVE.json",
    "frontend_binding_registry": "governance/SCHEDULER_FRONTEND_BINDINGS.json"
  },
  "delegated_spawn_authority": {
    "authorization_basis": "EXPLICIT_CURRENT_HUMAN_REQUEST_2026-10-07",
    "allowed_roles": ["research", "manager"],
    "primary_allowed": false,
    "master_allowed": false,
    "full_swarm_auto_start_allowed": false,
    "max_workers_per_occurrence": 1,
    "max_tickets_per_scheduler_invocation": 3,
    "project_binding_required_before_protected_work": true,
    "spawn_authority_is_not_mutation_authority": true,
    "role_or_ticket_is_not_mutation_authority": true
  },
  "scheduler_state_boundary": {
    "synchronization_authorized_by_human_directive": true,
    "declared_mapping_required": true,
    "may_reconcile_mapped_chatgpt_scheduled_tasks": true,
    "may_enable_mapped_chatgpt_task_when_binding_policy_is_MIRROR": true,
    "may_disable_mapped_chatgpt_task_when_binding_policy_is_MIRROR": true,
    "may_reschedule_mapped_chatgpt_task_to_canonical_backend_schedule": true,
    "may_rename_mapped_chatgpt_task_to_declared_frontend_title": true,
    "may_modify_unmapped_chatgpt_tasks": false,
    "may_create_or_delete_unmapped_chatgpt_tasks": false,
    "may_infer_mapping_from_title_similarity": false,
    "personal_frontend_tasks_remain_frontend_control": true,
    "scheduler_sync_does_not_expand_project_mutation_authority": true
  },
  "admission": {
    "reference": "org_agent_mesh.launch_admission",
    "provider_admission_required": true,
    "max_inflight": 1,
    "minimum_start_spacing_seconds": 30,
    "retryable_prebootstrap_results": [
      "TOO_MANY_REQUESTS",
      "RATE_LIMITED",
      "TEMPORARY_PROVIDER_UNAVAILABLE",
      "TIMEOUT_BEFORE_BOOTSTRAP"
    ],
    "catch_up_policy": "COALESCE_TO_LATEST",
    "blind_historical_replay": false
  },
  "failure_semantics": {
    "adapter_missing": "SPAWN_ADAPTER_UNAVAILABLE",
    "adapter_rejected": "SPAWN_ADAPTER_REJECTED",
    "adapter_accepted_without_start_receipt": "DISPATCH_ACCEPTED_START_UNVERIFIED",
    "provider_rejected_before_bootstrap": "LAUNCH_PROVIDER_ADMISSION_FAILED",
    "ticket_created_without_host_receipt": "SPAWN_TICKET_PENDING",
    "scheduler_mapping_conflict": "SCHEDULER_SYNC_CONFLICT",
    "frontend_state_unavailable": "FRONTEND_SCHEDULER_STATE_UNAVAILABLE",
    "never_call_missing_adapter_task_failed": true,
    "never_claim_spawn_from_ticket_alone": true
  },
  "observability": {
    "record_scheduled_for": true,
    "record_observed_at": true,
    "record_occurrence_id": true,
    "record_ticket_id": true,
    "record_adapter_result": true,
    "record_start_receipt": true,
    "record_bootstrap_ready_separately": true,
    "record_final_outcome_separately": true,
    "record_frontend_binding_id": true,
    "record_frontend_observed_state": true,
    "record_backend_canonical_state": true,
    "record_sync_disposition": true
  }
}
