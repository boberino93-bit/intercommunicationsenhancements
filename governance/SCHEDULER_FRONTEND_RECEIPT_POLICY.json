{
  "schema": "org-agent-mesh/scheduler-frontend-receipt-policy/v1",
  "version": "1.4.0",
  "status": "ACTIVE",
  "receipt_schema": "schemas/frontend_execution_receipt.schema.json",
  "message_schema": "schemas/scheduler_frontend_receipt_message.schema.json",
  "validator": "org_agent_mesh.frontend_execution_receipts",
  "backend_auditor": "org_agent_mesh.frontend_receipt_audit",
  "occurrence_claim_policy": "governance/SCHEDULER_OCCURRENCE_CLAIM_POLICY.json",
  "purpose": "Verify exact mapped ChatGPT frontend executions while detecting duplicate delivery of one deterministic scheduled occurrence and keeping runtime evidence off protected canonical main.",
  "publisher": {
    "mode": "DECLARED_RECONCILER_OR_EXACT_SELF",
    "project_id": "intercommunicationsenhancements",
    "repository": "boberino93-bit/intercommunicationsenhancements",
    "declared_reconciler_frontend_automation_id": "6ac63d38cc688191b9de4213ca40f951",
    "declared_reconciler_frontend_title": "Bootstrap Spawn Bridge",
    "ordinary_capacity_workers_may_publish_execution_receipts": true,
    "ordinary_capacity_worker_receipt_scope": "EXACT_SELF_ONLY",
    "self_publisher_id_must_equal_receipt_frontend_automation_id": true,
    "self_receipt_binding_must_match_declared_mapping": true,
    "publisher_may_only_report_observed_frontend_state": true,
    "publisher_may_not_infer_execution_from_expected_schedule": true,
    "receipt_publication_conveys_no_scheduler_or_project_mutation_authority": true
  },
  "transport": {
    "preferred": "REGISTERED_SAME_PROJECT_AGENTBUS_ARTIFACTORY",
    "degraded": "GITHUB_APPEND_ONLY_COORDINATION_BACKUP",
    "github_repository": "boberino93-bit/intercommunicationsenhancements",
    "github_storage_branch": "scheduler-evidence",
    "github_directory": "agentbus-backup/coordination-messages",
    "github_filename_prefix": "scheduler-frontend-receipt__",
    "github_operation": "CREATE_NEW_FILE_ONLY",
    "runtime_github_write_to_main_prohibited": true,
    "overwrite_prohibited": true,
    "delete_prohibited": true,
    "update_prohibited": true,
    "force_push_prohibited": true,
    "workflow_dispatch_prohibited": true,
    "backend_scan_is_read_only": true,
    "backend_scan_must_read_scheduler_evidence_branch": true,
    "backend_scan_ignores_non_receipt_coordination_messages": true,
    "receipt_shaped_validation_failure": "FRONTEND_EXECUTION_RECEIPT_REJECTED"
  },
  "verification": {
    "exact_occurrence_id_required": true,
    "exact_backend_job_id_required": true,
    "exact_binding_id_required": true,
    "exact_frontend_automation_id_required": true,
    "publisher_must_be_declared_reconciler_or_exact_self": true,
    "exact_project_id_required": true,
    "exact_repository_required": true,
    "scheduled_for_must_match_occurrence": true,
    "observed_run_at_must_not_predate_schedule": true,
    "observed_run_at_must_not_be_later_than_observed_at": true,
    "default_maximum_start_delay_minutes": 30,
    "title_similarity_is_not_proof": true,
    "conversation_id_is_not_proof": true,
    "backend_spawn_ticket_is_not_frontend_execution_proof": true,
    "frontend_expected_status_is_not_frontend_execution_proof": true,
    "enabled_flag_is_not_frontend_execution_proof": true,
    "exact_duplicate_receipt_is_idempotent": true,
    "conflicting_reuse_of_receipt_id_is_rejected": true,
    "one_distinct_execution_receipt_per_occurrence_required": true,
    "multiple_distinct_receipts_for_same_occurrence_are_rejected_as_duplicate_execution_evidence": true,
    "duplicate_occurrence_is_excluded_from_health_evidence": true
  },
  "authority": {
    "receipt_conveys_authority": false,
    "receipt_conveys_mutation_authority": false,
    "receipt_may_not_enable_or_disable_tasks": true,
    "receipt_may_not_rebind_dead_identity": true,
    "receipt_may_not_change_project_authority": true,
    "backend_ingestion_is_observability_only": true,
    "evidence_branch_write_authority_is_not_main_branch_write_authority": true
  },
  "duplicate_execution": {
    "frontend_work_ownership_gate": "governance/SCHEDULER_OCCURRENCE_CLAIM_POLICY.json",
    "receipt_audit_disposition": "FRONTEND_DUPLICATE_OCCURRENCE_EVIDENCE",
    "duplicate_occurrence_must_not_qualify_lane_health": true,
    "duplicate_occurrence_must_not_be_silently_collapsed_unless_receipt_is_exact_idempotent_duplicate": true
  },
  "cutover": {
    "storage_branch": "scheduler-evidence",
    "cutover_main_commit": "c21386601432ca7bca8b11a85f41341461887918",
    "storage_branch_created_from_cutover_main_commit": true,
    "future_degraded_github_receipts_must_write_to_storage_branch": true
  },
  "failure_semantics": {
    "missing_receipt": "FRONTEND_EXECUTION_UNVERIFIED",
    "identity_mismatch": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "publisher_mismatch": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "project_or_repository_mismatch": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "occurrence_mismatch": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "duplicate_distinct_occurrence_receipts": "FRONTEND_DUPLICATE_OCCURRENCE_EVIDENCE",
    "timing_mismatch": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "authority_claim_present": "FRONTEND_EXECUTION_RECEIPT_REJECTED",
    "evidence_branch_unavailable": "SCHEDULER_EVIDENCE_BRANCH_UNAVAILABLE",
    "attempted_runtime_write_to_main": "SCHEDULER_EVIDENCE_WRONG_BRANCH",
    "persistence_blocked": "FRONTEND_RECEIPT_PERSISTENCE_BLOCKED"
  }
}
