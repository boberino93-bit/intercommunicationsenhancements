{
  "schema": "org-agent-mesh/owner-credential-recovery/v1",
  "version": "1.1.0",
  "status": "ACTIVE",
  "recovery_outcome": "ROTATE_CREDENTIAL_AND_RETURN_TO_NORMAL_AUTHORIZATION",
  "minimum_factor_quorum": 2,
  "strong_factor_required_when_available": true,
  "strong_factors": ["AUTHENTICATOR_TOTP", "PASSKEY", "HARDWARE_SECURITY_KEY", "OFFLINE_RECOVERY_CODE", "SIGNED_CHALLENGE"],
  "supporting_factors": ["REGISTERED_GITHUB_PROOF", "VERIFIED_EMAIL", "VERIFIED_MOBILE"],
  "single_factor_recovery_allowed": false,
  "same_device_dual_totp_counts_as_independent": false,
  "rotation_required": true,
  "audit_event_required": true,
  "normal_authorization_recheck_required_after_recovery": true,
  "preferred_secondary_factor": "AUTHENTICATOR_TOTP",
  "evidence_receipt_lifecycle_required": true,
  "evidence_receipt_module": "org_agent_mesh.evidence_lifecycle",
  "evidence_must_bind_owner_and_request": true,
  "evidence_must_have_verifier_reference": true,
  "evidence_must_be_fresh_and_unexpired": true,
  "evidence_is_single_use": true,
  "recovery_request_is_single_use": true,
  "replay_ledger_required": true,
  "replay_ledger_module": "org_agent_mesh.owner_recovery.RecoveryReplayLedger",
  "durable_record_guard_required": true,
  "durable_record_guard_module": "org_agent_mesh.durable_record_guard",
  "durable_prohibited_fields": ["ephemeral_value", "enrollment_material", "recovery_value"]
}
